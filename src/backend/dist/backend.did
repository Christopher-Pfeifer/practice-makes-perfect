type TeacherStudioAffiliation = 
 record {
   studioName: text;
   studioUserName: text;
   teacherUserName: text;
 };
type TeacherStudent = 
 record {
   studentUserName: text;
   teacherUserName: text;
 };
type TeacherSchedule = 
 record {
   dayOfWeek: text;
   duration: nat;
   endTime: text;
   lessonDate: text;
   notes: text;
   scheduleId: text;
   startTime: text;
   status: text;
   studentUsername: text;
   teacherUsername: text;
 };
type TeacherRecital = 
 record {
   date: text;
   notes: text;
   recitalId: text;
   recitalName: text;
   studentAssignments: text;
   teacherUsername: text;
   venue: text;
 };
type TeacherExamplePerformance = 
 record {
   attachedToAssignmentId: text;
   commentary: text;
   description: text;
   mediaUrl: text;
   notes: text;
   performanceId: text;
   teacherUsername: text;
   title: text;
 };
type TeacherDetail = 
 record {
   bio: text;
   certifications: text;
   instruments: text;
   notes: text;
   yearsExperience: text;
 };
type StudioDetail = 
 record {
   description: text;
   licenseNumber: text;
   notes: text;
   website: text;
 };
type StudentRepertoire = 
 record {
   composer: text;
   genre: text;
   notes: text;
   performanceDate: text;
   repertoireId: text;
   startDate: text;
   status: text;
   studentUsername: text;
   teacherUsername: text;
   title: text;
 };
type StudentProgress = 
 record {
   date: text;
   goalMet: bool;
   goalSet: text;
   notes: text;
   progressId: text;
   score: nat;
   skillCategory: text;
   studentUsername: text;
   teacherUsername: text;
 };
type StudentPractice = 
 record {
   duration: nat;
   pieceWorkedOn: text;
   practiceDate: text;
   practiceId: text;
   rating: nat;
   studentNotes: text;
   studentUsername: text;
   teacherFeedback: text;
   teacherUsername: text;
 };
type StudentMessage = 
 record {
   body: text;
   fromUsername: text;
   isPinned: bool;
   isRead: bool;
   messageId: text;
   studentUsername: text;
   subject: text;
   teacherUsername: text;
   timestamp: text;
   toUsername: text;
 };
type StudentLesson = 
 record {
   duration: nat;
   homeworkAssigned: text;
   lessonDate: text;
   lessonEntryId: text;
   studentUsername: text;
   teacherNotes: text;
   teacherUsername: text;
   topics: text;
 };
type StudentEnrollment = 
 record {
   enrollmentId: text;
   ensembleParticipation: text;
   instrument: text;
   notes: text;
   practiceGoals: text;
   skillLevel: text;
   studentUserName: text;
   studioName: text;
   teacherUserName: text;
   theoryLevel: text;
   voiceType: text;
 };
type StudentDetail = record {notes: text;};
type StudentCollaboration = 
 record {
   collaborationId: text;
   groupName: text;
   groupType: text;
   members: text;
   rehearsalDates: text;
   sharedRepertoire: text;
   studentUsername: text;
   teacherUsername: text;
 };
type StudentBilling = 
 record {
   amountPaid: float64;
   billingId: text;
   billingMonth: text;
   notes: text;
   paymentDate: text;
   status: text;
   studentUsername: text;
   teacherUsername: text;
   tuitionAmount: float64;
 };
type StudentAssignment = 
 record {
   assignmentId: text;
   attachedExampleUrl: text;
   description: text;
   dueDate: text;
   priority: text;
   status: text;
   studentUsername: text;
   teacherFeedback: text;
   teacherUsername: text;
   title: text;
 };
type Role = 
 variant {
   Admin;
   Parent;
   Student;
   Studio;
   Teacher;
   Unassigned;
 };
type RestoreResult = 
 variant {
   err: text;
   ok;
 };
type ProfileUpdate = 
 record {
   address1: opt text;
   address2: opt text;
   city: opt text;
   comments: opt text;
   description: opt text;
   email: opt text;
   fullName: opt text;
   parentAffiliation: opt text;
   password: opt text;
   phone: opt text;
   role: opt Role;
   state: opt text;
   studentAffiliations: opt vec text;
   studioAffiliation: opt text;
   teacherAffiliation: opt text;
   zip: opt text;
 };
type Profile = 
 record {
   address1: text;
   address2: text;
   city: text;
   comments: text;
   description: text;
   email: text;
   fullName: text;
   parentAffiliation: text;
   password: text;
   phone: text;
   role: Role;
   state: text;
   studentAffiliations: vec text;
   studioAffiliation: text;
   teacherAffiliation: text;
   username: text;
   zip: text;
 };
type ParentStudent = 
 record {
   parentUserName: text;
   studentUserName: text;
 };
type MasterInstrument = 
 record {
   name: text;
   sortOrder: nat;
 };
type Lesson = 
 record {
   date: text;
   duration: text;
   instrument: text;
   lessonId: text;
   notes: text;
   status: text;
   studentUsername: text;
   studioUsername: text;
   teacherUsername: text;
 };
type FullDump = 
 record {
   lessons: vec record {
                  text;
                  Lesson;
                };
   masterInstruments: vec record {
                            text;
                            MasterInstrument;
                          };
   parentStudents: vec record {
                         text;
                         ParentStudent;
                       };
   profiles: vec record {
                   text;
                   Profile;
                 };
   studentAssignments: vec record {
                             text;
                             StudentAssignment;
                           };
   studentBilling: vec record {
                         text;
                         StudentBilling;
                       };
   studentCollaboration: vec record {
                               text;
                               StudentCollaboration;
                             };
   studentDetails: vec record {
                         text;
                         StudentDetail;
                       };
   studentEnrollments: vec record {
                             text;
                             StudentEnrollment;
                           };
   studentLessons: vec record {
                         text;
                         StudentLesson;
                       };
   studentMessages: vec record {
                          text;
                          StudentMessage;
                        };
   studentPractices: vec record {
                           text;
                           StudentPractice;
                         };
   studentProgress: vec record {
                          text;
                          StudentProgress;
                        };
   studentRepertoire: vec record {
                            text;
                            StudentRepertoire;
                          };
   studioDetails: vec record {
                        text;
                        StudioDetail;
                      };
   teacherDetails: vec record {
                         text;
                         TeacherDetail;
                       };
   teacherExamplePerformances: vec record {
                                     text;
                                     TeacherExamplePerformance;
                                   };
   teacherRecitals: vec record {
                          text;
                          TeacherRecital;
                        };
   teacherSchedule: vec record {
                          text;
                          TeacherSchedule;
                        };
   teacherStudents: vec record {
                          text;
                          TeacherStudent;
                        };
   teacherStudioAffiliations: vec record {
                                    text;
                                    TeacherStudioAffiliation;
                                  };
 };
type DumpResult = 
 variant {
   err: text;
   ok: FullDump;
 };
